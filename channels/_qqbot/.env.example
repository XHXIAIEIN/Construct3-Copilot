# Copy to .env and fill in. bot.py reads it before anything else; never commit .env.

# QQ open platform (q.qq.com): the bot's AppID and secret
QQ_APPID=
QQ_SECRET=

# The model. Default: DeepSeek over its OpenAI-compatible API.
DEEPSEEK_API_KEY=
# Any other OpenAI-compatible server: Ollama http://localhost:11434/v1, SiliconFlow, Zhipu https://open.bigmodel.cn/api/paas/v4
#C3BOT_BASE_URL=
#C3BOT_MODEL=
#C3BOT_API_KEY=
#SILICONFLOW_API_KEY=
#ZHIPU_API_KEY=
# JSON that replaces the "thinking off" switch for a model that wants another one
#C3BOT_EXTRA_BODY=

# Knowledge: the Construct3-RAG clone and the official examples clone; default: sibling folders of this one
#CONSTRUCT3_RAG=
#C3_EXAMPLES=
#C3BOT_LOCALE=zh-CN
# the plugin under plugins/ (default construct3)
#C3BOT_PLUGIN=construct3

# Where the bot writes logs, sessions, reviews and archives (default: var/ in this folder)
#C3BOT_DATA=

# Making projects: 1 = quick mode (no design check, no editor play), for a slow or small model
#C3BOT_QUICK=
# 0 = skip opening a built project in the headless editor (a machine without Edge or Chrome)
#C3BOT_EDITOR_CHECK=1
# 1 = allow new_project_from_template (check the examples' license first)
#C3BOT_TEMPLATE_COPY=
# the editor's browser profile for a second bot process beside the live one
#C3BOT_PROFILE=

# Local model on a shared GPU: logs of a TTS server to watch, separated by ";"; the model is unloaded while they are written
#C3BOT_YIELD_LOGS=
#C3BOT_REASONING=none

# grader.py: codex (default) or claude, and the Codex model
#GRADER=codex
#CODEX_MODEL=
