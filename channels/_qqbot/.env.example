# Copy to .env and fill in. qqbot.qq reads it before anything else; never commit .env.

# QQ open platform (q.qq.com): the bot's AppID and secret
QQ_APPID=
QQ_SECRET=

# Local OpenAI-compatible model server. The panel updates these settings.
DEEPSEEK_API_KEY=
# Any other OpenAI-compatible server: Ollama http://localhost:11434/v1, SiliconFlow, Zhipu https://open.bigmodel.cn/api/paas/v4
C3BOT_BASE_URL=http://localhost:11434/v1
C3BOT_MODEL=installed-model-name
C3BOT_API_KEY=ollama
#SILICONFLOW_API_KEY=
#ZHIPU_API_KEY=
# JSON that replaces the "thinking off" switch for a model that wants another one
#C3BOT_EXTRA_BODY=

# Execution: trusted local checkouts, default: sibling folders of this one.
# C3BOT_SKILLS accepts the repository, plugin/ folder or construct3-agent-plugin skill folder.
#C3BOT_COPILOT=../Construct3-Copilot
#C3BOT_SKILLS=../Construct3-Agent-Skills

# Data: the Construct3-RAG clone and the official examples clone; default: sibling folders of this one
#CONSTRUCT3_RAG=
#C3_EXAMPLES=
#C3BOT_LOCALE=zh-CN
# the provider loaded from Copilot (default construct3)
QQBOT_APP=construct3

# Where the bot writes logs, sessions, reviews and archives (default: var/ in this folder)
#QQBOT_DATA=

# Making projects: 1 = quick prototype with an explicit unverified-runtime notice.
# Default 0 requires a checked design and successful editor tests before adopting the project.
#C3BOT_QUICK=
# 0 = deliver a structurally checked project with an explicit unverified-runtime notice.
#C3BOT_EDITOR_CHECK=1
# 1 = allow new_project_from_template (check the examples' license first)
#C3BOT_TEMPLATE_COPY=
# the editor's browser profile for a second bot process beside the live one
#C3BOT_PROFILE=

# Local model on a shared GPU: logs of a TTS server to watch, separated by ";"; the model is unloaded while they are written
#C3BOT_YIELD_LOGS=
#C3BOT_REASONING=none

# qqbot.grader: codex (default) or claude, and the Codex model
#GRADER=codex
#CODEX_MODEL=

# API profiles use C3BOT_API_KEY_ENV to reference a key already stored in this file.
# Manage profiles through start.cmd; metadata is stored in var/apis.json.
