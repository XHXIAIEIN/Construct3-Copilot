{"name": "接水果",
 "objects": [
  {"name": "Basket", "plugin": "Sprite", "shape": "rect", "size": [4, 1], "frames": ["reward"]},
  {"name": "Fruit", "plugin": "Sprite", "shape": "circle", "size": [2, 2], "frames": ["danger"]},
  {"name": "Hud", "plugin": "Text"},
  {"name": "Touch", "plugin": "Touch"}],
 "layouts": [{"name": "Game", "sheet": "Game",
  "layers": [{"name": "Background", "color": "canvas"}, {"name": "Game"}, {"name": "UI", "parallax": 0}],
  "instances": [
   {"object": "Basket", "layer": "Game", "col": "center", "row": 36},
   {"object": "Fruit", "layer": "Game", "col": 10, "row": 4},
   {"object": "Hud", "layer": "UI", "text": "Score 0  Lives 3", "anchor": "top-left", "longest": "Over: 99. Tap left"}]}],
 "sheets": [{"name": "Game", "events": [
  {"eventType": "comment", "text": "Catch. Tap left or right to move the basket under the falling fruit"},
  {"eventType": "variable", "name": "score", "type": "number", "initialValue": "0"},
  {"eventType": "variable", "name": "lives", "type": "number", "initialValue": "3"},
  {"eventType": "variable", "name": "over", "type": "number", "initialValue": "0"},
  {"eventType": "comment", "text": "new-game: a new game starts with no score and three lives"},
  {"eventType": "block", "conditions": [{"id": "on-start-of-layout", "objectClass": "System"}],
   "actions": [{"id": "set-eventvar-value", "objectClass": "System", "parameters": {"variable": "score", "value": "0"}},
               {"id": "set-eventvar-value", "objectClass": "System", "parameters": {"variable": "lives", "value": "3"}},
               {"id": "set-eventvar-value", "objectClass": "System", "parameters": {"variable": "over", "value": "0"}}]},
  {"eventType": "comment", "text": "move-left: a tap on the left half moves the basket left"},
  {"eventType": "block", "conditions": [{"id": "on-any-touch-start", "objectClass": "Touch"},
     {"id": "compare-two-values", "objectClass": "System", "parameters": {"first-value": "Touch.X", "comparison": 2, "second-value": "360"}},
     {"id": "compare-eventvar", "objectClass": "System", "parameters": {"variable": "over", "comparison": 0, "value": "0"}}],
   "actions": [{"id": "set-x", "objectClass": "Basket", "parameters": {"x": "max(64, Basket.X - 96)"}}]},
  {"eventType": "comment", "text": "move-right: a tap on the right half moves the basket right"},
  {"eventType": "block", "conditions": [{"id": "on-any-touch-start", "objectClass": "Touch"},
     {"id": "compare-two-values", "objectClass": "System", "parameters": {"first-value": "Touch.X", "comparison": 5, "second-value": "360"}},
     {"id": "compare-eventvar", "objectClass": "System", "parameters": {"variable": "over", "comparison": 0, "value": "0"}}],
   "actions": [{"id": "set-x", "objectClass": "Basket", "parameters": {"x": "min(656, Basket.X + 96)"}}]},
  {"eventType": "comment", "text": "again: once it is over, a tap on the left half restarts"},
  {"eventType": "block", "conditions": [{"id": "on-any-touch-start", "objectClass": "Touch"},
     {"id": "compare-two-values", "objectClass": "System", "parameters": {"first-value": "Touch.X", "comparison": 2, "second-value": "360"}},
     {"id": "compare-eventvar", "objectClass": "System", "parameters": {"variable": "over", "comparison": 0, "value": "1"}}],
   "actions": [{"id": "restart-layout", "objectClass": "System"}]},
  {"eventType": "comment", "text": "fall: the fruit falls while the game runs"},
  {"eventType": "block", "conditions": [{"id": "compare-eventvar", "objectClass": "System", "parameters": {"variable": "over", "comparison": 0, "value": "0"}}],
   "actions": [{"id": "set-y", "objectClass": "Fruit", "parameters": {"y": "Fruit.Y + 400 * dt"}}],
   "children": [
    {"eventType": "comment", "text": "catch: the fruit reaches the basket"},
    {"eventType": "block", "conditions": [
       {"id": "compare-two-values", "objectClass": "System", "parameters": {"first-value": "Fruit.Y", "comparison": 5, "second-value": "1100"}},
       {"id": "compare-two-values", "objectClass": "System", "parameters": {"first-value": "abs(Fruit.X - Basket.X)", "comparison": 2, "second-value": "80"}}],
     "actions": [{"id": "add-to-eventvar", "objectClass": "System", "parameters": {"variable": "score", "value": "1"}},
                 {"id": "set-y", "objectClass": "Fruit", "parameters": {"y": "0"}},
                 {"id": "set-x", "objectClass": "Fruit", "parameters": {"x": "64 + floor(random(593))"}},
                 {"id": "set-text", "objectClass": "Hud", "parameters": {"text": "\"Score \" & score & \"  Lives \" & lives"}}]},
    {"eventType": "comment", "text": "miss: the fruit passes the basket"},
    {"eventType": "block", "conditions": [{"id": "else", "objectClass": "System"},
       {"id": "compare-two-values", "objectClass": "System", "parameters": {"first-value": "Fruit.Y", "comparison": 5, "second-value": "1100"}}],
     "actions": [{"id": "subtract-from-eventvar", "objectClass": "System", "parameters": {"variable": "lives", "value": "1"}},
                 {"id": "set-y", "objectClass": "Fruit", "parameters": {"y": "0"}},
                 {"id": "set-x", "objectClass": "Fruit", "parameters": {"x": "64 + floor(random(593))"}},
                 {"id": "set-text", "objectClass": "Hud", "parameters": {"text": "\"Score \" & score & \"  Lives \" & lives"}}],
     "children": [
      {"eventType": "comment", "text": "end: the last life is gone"},
      {"eventType": "block", "conditions": [{"id": "compare-eventvar", "objectClass": "System", "parameters": {"variable": "lives", "comparison": 3, "value": "0"}}],
       "actions": [{"id": "set-eventvar-value", "objectClass": "System", "parameters": {"variable": "over", "value": "1"}},
                   {"id": "set-text", "objectClass": "Hud", "parameters": {"text": "\"Over: \" & score & \". Tap left\""}}]}]}]}
 ]}]}
